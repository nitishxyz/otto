	"devDependencies": {
		"@types/bun": "1.3.14",
		"typescript": "5.9.3"
	},
	"keywords": [
		"ai",
		"sdk",
		"agents",
		"tools",
		"llm",
		"anthropic",
		"openai",
		"development",
		"assistant",
		"tree-shakable",
		"typescript"
	]
}
