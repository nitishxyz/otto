{
	"name": "@ottocode/database",
	"version": "0.1.408",
	"description": "Database and persistence layer for ottocode",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nitishxyz/otto.git",
		"directory": "packages/database"
	},
	"exports": {
		".": {
			"import": "./src/index.ts",
			"types": "./src/index.ts"
		},
		"./schema": {
			"import": "./src/schema.ts",
			"types": "./src/schema.ts"
		}
	},
	"scripts": {
		"dev": "bun run src/index.ts",
		"test": "bun test",
		"db:generate": "drizzle-kit generate --config=drizzle.config.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@ottocode/sdk": "workspace:*",
		"drizzle-orm": "0.44.7"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"drizzle-kit": "0.31.9",
		"typescript": "5.9.3"
	}
}
